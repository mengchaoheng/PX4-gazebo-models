<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="iris">
    <!-- Keep the classic collision just above the ground at default spawn. -->
    <pose>0 0 0.05 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.75</mass>
        <inertia>
          <ixx>0.0025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0021</iyy>
          <iyz>0</iyz>
          <izz>0.0043</izz>
        </inertia>
      </inertial>
      <collision name="base_link_inertia_collision">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1766 0.1939 0.0490</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name="base_link_inertia_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris.stl</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.40 0.41 0.44 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>

      <!-- GZBridge currently requires these native sensors and names on base_link. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.02 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>1.0</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <pose>0.05 0 0.04 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
      </sensor>
    </link>

    <!-- Classic mounts its IMU directly on base_link. Keep the GPS visual but
         its inertial contribution negligible, just as gps0 is in Classic. -->
    <link name="gps_link">
      <pose>0.05 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>1e-09</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-09</iyy>
          <iyz>0</iyz>
          <izz>1e-09</izz>
        </inertia>
      </inertial>
      <visual name="gps_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="gps_joint" type="fixed">
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <link name="rotor_0">
      <pose>0.13 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>4.0981e-08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0981e-08</iyy>
          <iyz>0</iyz>
          <izz>8.192e-08</izz>
