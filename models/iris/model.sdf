<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="iris">
    <!-- Keep the classic collision just above the ground at default spawn. -->
    <pose>0 0 0.05 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.75</mass>
        <inertia>
          <ixx>0.0025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0021</iyy>
          <iyz>0</iyz>
          <izz>0.0043</izz>
        </inertia>
      </inertial>
      <collision name="base_link_inertia_collision">
        <pose>0 0 -0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1766 0.1939 0.0490</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name="base_link_inertia_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris.stl</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.25 0.26 0.28 1</ambient>
          <diffuse>0.40 0.41 0.44 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>

      <!-- GZBridge currently requires these native sensors and names on base_link. -->
      <sensor name="imu_sensor" type="imu">
        <!-- Classic IMU plugin measures base_link at its origin. -->
        <pose>0 0 0 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.013798038847</stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.100718543476</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>1.0</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.004</stddev>
              <dynamic_bias_stddev>0.000110851251684</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>600</dynamic_bias_correlation_time>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <pose>0.05 0 0.04 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
      </sensor>
    </link>

    <!-- Classic mounts its IMU directly on base_link. Keep the GPS visual but
         its inertial contribution negligible, just as gps0 is in Classic. -->
    <link name="gps_link">
      <pose>0.05 0 0.04 0 0 0</pose>
      <inertial>
        <mass>0.000001</mass>
        <inertia>
          <ixx>1e-09</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-09</iyy>
          <iyz>0</iyz>
          <izz>1e-09</izz>
        </inertia>
      </inertial>
      <visual name="gps_visual">
        <geometry>
          <cylinder>
            <radius>0.01</radius>
            <length>0.002</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.01 0.01 0.01 1</ambient>
          <diffuse>0.01 0.01 0.01 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="gps_joint" type="fixed">
      <parent>base_link</parent>
      <child>gps_link</child>
    </joint>

    <link name="rotor_0">
      <pose>0.125 -0.22 0.023 0 0 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>4.0981e-08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0981e-08</iyy>
          <iyz>0</iyz>
          <izz>8.192e-08</izz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.128</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
      <visual name="rotor_0_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_0_housing_visual">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.24 0.08 0.07 1</ambient>
          <diffuse>0.52 0.18 0.16 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_1">
      <pose>-0.1385 0.206 0.023 0 0 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>4.0981e-08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0981e-08</iyy>
          <iyz>0</iyz>
          <izz>8.192e-08</izz>
        </inertia>
      </inertial>
      <collision name="rotor_1_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.128</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
      <visual name="rotor_1_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris_prop_ccw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_1_housing_visual">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.24 0.08 0.07 1</ambient>
          <diffuse>0.52 0.18 0.16 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_2">
      <pose>0.125 0.223 0.023 0 0 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>4.0981e-08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0981e-08</iyy>
          <iyz>0</iyz>
          <izz>8.192e-08</izz>
        </inertia>
      </inertial>
      <collision name="rotor_2_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.128</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
      <visual name="rotor_2_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_2_housing_visual">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.24 0.08 0.07 1</ambient>
          <diffuse>0.52 0.18 0.16 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.1385 -0.2025 0.023 0 0 0</pose>
      <inertial>
        <mass>0.00001</mass>
        <inertia>
          <ixx>4.0981e-08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0981e-08</iyy>
          <iyz>0</iyz>
          <izz>8.192e-08</izz>
        </inertia>
      </inertial>
      <collision name="rotor_3_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.128</radius>
          </cylinder>
        </geometry>
        <surface>
          <contact><ode/></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
      <visual name="rotor_3_visual">
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://iris/meshes/iris_prop_cw.dae</uri>
          </mesh>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.035 0.035 0.035 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <visual name="motor_3_housing_visual">
        <pose>0 0 -0.018 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.024</radius>
            <length>0.030</length>
          </cylinder>
        </geometry>
        <material>
          <lighting>true</lighting>
          <ambient>0.24 0.08 0.07 1</ambient>
          <diffuse>0.52 0.18 0.16 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <cast_shadows>true</cast_shadows>
      </visual>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- Linear drag from Sun et al. (2022), Table II. Force at COM.
         Rotor drag below stays zero to avoid counting this force twice. -->
    <plugin filename="DuctedFanLiftDragPlugin" name="px4::DuctedFanLiftDrag">
      <link_name>base_link</link_name>
      <cp>0 0 0</cp>
      <area>0</area>
      <linear_drag>0.26 0.28 0.42</linear_drag>
      <!-- Angular damping stress case: 20x the initial inertia-scaled values.
           Free-decay times J/K are approximately 0.38, 0.39 and 0.17 s. -->
      <angular_drag>0.0066 0.0054 0.026</angular_drag>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0005</timeConstantUp>
      <timeConstantDown>0.0005</timeConstantDown>
      <maxRotVelocity>2372.6</maxRotVelocity>
      <motorConstant>1.51e-06</motorConstant>
      <momentConstant>0.0157</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0005</timeConstantUp>
      <timeConstantDown>0.0005</timeConstantDown>
      <maxRotVelocity>2372.6</maxRotVelocity>
      <motorConstant>1.51e-06</motorConstant>
      <momentConstant>0.0157</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0005</timeConstantUp>
      <timeConstantDown>0.0005</timeConstantDown>
      <maxRotVelocity>2372.6</maxRotVelocity>
      <motorConstant>1.51e-06</motorConstant>
      <momentConstant>0.0157</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0005</timeConstantUp>
      <timeConstantDown>0.0005</timeConstantDown>
      <maxRotVelocity>2372.6</maxRotVelocity>
      <motorConstant>1.51e-06</motorConstant>
      <momentConstant>0.0157</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <!-- Optional body-FLU sine force/torque disturbance.
         Disabled by running_time=0; amplitudes below are peak values. -->
    <plugin name="px4::TorqueDisturbancePlugin" filename="TorqueDisturbancePlugin">
      <!-- Authority-normalized body-FLU sine: F 3/3/10%, tau 5/5/3%.
           Percentages refer to acceleration/torque capability, not raw N/Nm. -->
      <link_name>base_link</link_name>
      <mode>sine</mode>
      <frame>body_flu</frame>
      <start_time>30.0</start_time>
      <running_time>0</running_time>
      <repeat_count>1</repeat_count>
      <repeat_interval>8.0</repeat_interval>
      <bias_x>0</bias_x>
      <bias_y>0</bias_y>
      <bias_z>0</bias_z>
      <amplitude_x>0.0736801232</amplitude_x>
      <amplitude_y>-0.0456279967</amplitude_y>
      <amplitude_z>-0.00313348436</amplitude_z>
      <frequency_x>0.2</frequency_x>
      <frequency_y>0.4</frequency_y>
      <frequency_z>0.2</frequency_z>
      <force_bias_x>0</force_bias_x>
      <force_bias_y>0</force_bias_y>
      <force_bias_z>0</force_bias_z>
      <force_amplitude_x>0.995864252</force_amplitude_x>
      <force_amplitude_y>-0.995864252</force_amplitude_y>
      <force_amplitude_z>-0.565510984</force_amplitude_z>
      <force_frequency_x>0.1</force_frequency_x>
      <force_frequency_y>0.2</force_frequency_y>
      <force_frequency_z>0.3</force_frequency_z>
      <wrench_topic>/iris/disturbance_wrench</wrench_topic>
      <publish_rate>50</publish_rate>
    </plugin>

    <!-- gazebo_motor_model handles this internally; GZ uses a separate system. -->
    <plugin filename="MotorFailurePlugin"
            name="gz::sim::systems::MotorFailureSystem">
    </plugin>
  </model>
</sdf>
