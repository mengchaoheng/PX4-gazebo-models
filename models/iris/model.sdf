    <!-- Optional repeatable random-gust experiment.

         This uses the low-disturbance Gauss-Markov model from
         UAV_Algorithm_Benchmark/main.m: translational force is expressed in
         inertial NED, torque in body FRD, and every amplitude below is the
         stationary RMS value of that axis (not a peak value).

         It is disabled in the normal gz_iris target because running_time <= 0.
         Set running_time to a positive duration and restart the simulation to
         enable it; no separate Iris model or airframe is required. -->
    <plugin name="px4::TorqueDisturbancePlugin" filename="TorqueDisturbancePlugin">
      <link_name>base_link</link_name>
      <mode>gauss_markov</mode>
      <force_frame>world_ned</force_frame>
      <torque_frame>body_frd</torque_frame>
      <seed>2042294704</seed>
      <force_correlation_time_x>1.5</force_correlation_time_x>
      <force_correlation_time_y>1.5</force_correlation_time_y>
      <force_correlation_time_z>1.0</force_correlation_time_z>
      <torque_correlation_time_x>0.35</torque_correlation_time_x>
      <torque_correlation_time_y>0.35</torque_correlation_time_y>
      <torque_correlation_time_z>0.25</torque_correlation_time_z>
      <start_time>45.0</start_time>
      <running_time>0.0</running_time>
      <repeat_count>1</repeat_count>
      <amplitude_x>0.025</amplitude_x>
      <amplitude_y>0.025</amplitude_y>
      <amplitude_z>0.0025</amplitude_z>
      <force_amplitude_x>0.15</force_amplitude_x>
      <force_amplitude_y>0.15</force_amplitude_y>
      <force_amplitude_z>0.08</force_amplitude_z>
      <wrench_topic>/iris/disturbance_wrench</wrench_topic>
      <publish_rate>50</publish_rate>
    </plugin>

    <!-- gazebo_motor_model handles this internally; GZ uses a separate system. -->
    <plugin filename="MotorFailurePlugin"
            name="gz::sim::systems::MotorFailureSystem">
    </plugin>
  </model>
</sdf>
