<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="ductedfan2">
    <pose>0 0 0.5 0 0 0</pose>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
