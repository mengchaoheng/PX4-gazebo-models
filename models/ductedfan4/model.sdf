    <joint name="cs1_joint" type="revolute">
      <parent>base_link</parent>
      <child>cs1</child>
      <pose>0 0 -0.140995 0 -0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.3491</lower>
          <upper>0.3491</upper>
          <!-- Backend ceiling; the native position controller applies its
               own force-command limits. This is not a servo torque rating. -->
          <effort>1e6</effort>
        </limit>
        <dynamics>
          <damping>0.00000004</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>
