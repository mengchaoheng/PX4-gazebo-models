    <plugin name="px4::TorqueDisturbancePlugin" filename="TorqueDisturbancePlugin">
      <!-- Authority-normalized body-FLU sine: F 3/3/10%, tau 5/5/3%.
           Percentages refer to acceleration/torque capability, not raw N/Nm. -->
      <link_name>base_link</link_name>
      <!-- Sine disturbance preset shared with the Classic model (body FLU). -->
      <mode>sine</mode>
      <frame>body_flu</frame>
      <start_time>30.0</start_time>
      <running_time>0</running_time>
      <repeat_count>1</repeat_count>
      <repeat_interval>8.0</repeat_interval>
      <bias_x>0</bias_x>
      <bias_y>0</bias_y>
      <bias_z>0</bias_z>
      <amplitude_x>0.0173225155</amplitude_x>
      <amplitude_y>-0.0173225155</amplitude_y>
      <amplitude_z>-0.00858864842</amplitude_z>
      <frequency_x>0.2</frequency_x>
      <frequency_y>0.4</frequency_y>
      <frequency_z>0.2</frequency_z>
      <force_bias_x>0</force_bias_x>
      <force_bias_y>0</force_bias_y>
      <force_bias_z>0</force_bias_z>
      <force_amplitude_x>0.458960563</force_amplitude_x>
      <force_amplitude_y>-0.458960563</force_amplitude_y>
      <force_amplitude_z>-1.17036721</force_amplitude_z>
      <force_frequency_x>0.1</force_frequency_x>
      <force_frequency_y>0.2</force_frequency_y>
      <force_frequency_z>0.3</force_frequency_z>
    </plugin>
    <static>0</static>

    <!-- Use the native force-based position controller and joint damping.
         Gains scale with the negligible visual-vane inertia; they approximate
         a 10 ms actuator response, not the physical servo's torque rating.
         No actuator filter is applied in the PX4 bridge. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>cs1_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
      <use_velocity_commands>false</use_velocity_commands>
      <p_gain>0.000004</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <cmd_max>2</cmd_max>
