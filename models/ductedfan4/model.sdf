    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_joint</jointName>
      <linkName>rotor</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.03</timeConstantUp>
      <timeConstantDown>0.03</timeConstantDown>
      <maxRotVelocity>1750</maxRotVelocity>
      <!-- Fmax=29.9584 N at maxRotVelocity=1750 rad/s. -->
      <motorConstant>9.782349e-06</motorConstant>
      <momentConstant>0.0</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <!-- Hull drag is modelled separately at its own centre of pressure below.
           Do not treat the entire duct/body drag as a force at the rotor COM. -->
      <rotorDragCoefficient>0</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <!-- Effective low-speed hull drag from flight logs 108/109; N/(m/s).
         cp is relative to base_link, whose COM is at z=0.011 m. Keeping this
         force at the COM avoids an unsupported rotor-offset pitching moment.
         area=0 selects only the linear/angular drag part of the plugin. -->
    <plugin filename="DuctedFanLiftDragPlugin" name="px4::DuctedFanLiftDrag">
      <link_name>base_link</link_name>
      <cp>0 0 0.011</cp>
      <area>0</area>
      <linear_drag>0.9 0.9 0.9</linear_drag>
      <angular_drag>0.003 0.003 0.003</angular_drag>
    </plugin>
    <!-- Vane lift acts at the original surface positions; r x F supplies torque.
         Real rotor wash and body-Z relative inflow set the dynamic pressure.
         The 0.011 m COM offset gives a 0.167 m roll/pitch lever arm.
         Zero-inflow hover torque matches the existing CA_SV_CS*_TRQ_* values. -->
    <plugin filename="DuctedFanLiftDragPlugin" name="px4::DuctedFanLiftDrag">
      <propeller_wind_map>
        <propeller>
          <joint>rotor_joint</joint>
          <k_v>0.015990232159</k_v>
          <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        </propeller>
        <wash_only>false</wash_only>
      </propeller_wind_map>
      <a0>0</a0>
      <cla>0</cla>
      <cda>0</cda>
      <cma>0</cma>
      <alpha_stall>0.6</alpha_stall>
      <cla_stall>0</cla_stall>
      <cda_stall>0</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>0.069 0 -0.156</cp>
      <area>0.00693</area>
      <air_density>1.2041</air_density>
      <forward>0 0 1</forward>
      <upward>0 -1 0</upward>
      <link_name>base_link</link_name>
      <control_joint_name>cs1_joint</control_joint_name>
      <control_joint_rad_to_cl>1.70864541647572</control_joint_rad_to_cl>
      <windSubTopic>world_wind</windSubTopic>
      <cm_delta>0</cm_delta>
      <axial_flow_only>true</axial_flow_only>
      <axial_momentum_flow>true</axial_momentum_flow>
      <axial_flow_axis>0 0 1</axial_flow_axis>
      <radial_symmetry>false</radial_symmetry>
      <reversible>true</reversible>
    </plugin>
    <plugin filename="DuctedFanLiftDragPlugin" name="px4::DuctedFanLiftDrag">
